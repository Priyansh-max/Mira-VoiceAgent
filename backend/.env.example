OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_VOICE=marin

# Primary chained pipeline providers/models:
STT_PROVIDER=openai
STT_MODEL=gpt-4o-mini-transcribe
STT_LANGUAGE=en
# Optional general transcription context. Leave blank to avoid biasing silent/noisy turns.
STT_PROMPT=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin

# Controlled benchmark variable. Use exactly one value per 20-turn run:
# llm | speech_directive
RESPONSE_MODE=speech_directive

# Optional. Defaults to backend/data/latency_samples.jsonl
LATENCY_LOG_PATH=
