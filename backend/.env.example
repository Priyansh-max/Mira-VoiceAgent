# Credentials
OPENAI_API_KEY=

# Conversation response strategy
# The UI normally sends this selection. This value is the backend fallback.
# Options: llm | speech_directive
RESPONSE_MODE=speech_directive

# Pipeline + Streaming: shared transcription and LLM settings
STT_LANGUAGE=en
# Optional transcription context. Leave blank to avoid biasing noisy turns.
STT_PROMPT=
LLM_MODEL=gpt-4o-mini

# 1. Pipeline mode: completed audio -> STT -> LLM -> completed TTS
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin

# 2. Streaming mode: live STT -> streaming LLM -> streaming TTS
STT_REALTIME_MODEL=gpt-live-transcribe
STT_REALTIME_DELAY=low
STT_REALTIME_CONNECT_TIMEOUT_SECONDS=10

# Uses TTS_MODEL and TTS_VOICE above. Audio is returned as streaming PCM.
STREAMING_TTS_PROVIDER=openai

# 3. Realtime mode: OpenAI Realtime over WebRTC
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_VOICE=marin

# Latency measurements
# Optional; defaults to backend/data/latency_samples.jsonl.
LATENCY_LOG_PATH=
